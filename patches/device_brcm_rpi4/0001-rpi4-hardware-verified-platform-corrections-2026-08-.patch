From 522a9c6ae0eb360145c7c2a329069268f737b6ef Mon Sep 17 00:00:00 2001
From: zeno <lvalentinzeno@gmail.com>
Date: Sat, 22 Aug 2026 02:40:09 -0800
Subject: [PATCH] rpi4: hardware-verified platform corrections (2026-08-16
 session)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Board-level fixes measured on a Pi 4 Rev 1.5 running the 20260413 image.
None of this is application-specific.

boot/config.txt — dtoverlay=miniuart-bt commented out, with the reason inline.
The overlay leaves a bluetooth node on both UARTs, so hci_uart_bcm (a serdev
driver bound via device tree, not through a tty) attaches to the PL011 the
overlay just routed to the GPIO header. HCI then goes out the console pins and
the console goes to the BT chip: silent UART, "Frame reassembly failed (-84)",
"command 0xfc18 tx timeout", "hardware error 0x10", and com.android.bluetooth
crash-looping. cmdline must stay console=ttyS0,115200 to match.

vendor.prop — ro.boot.wificountrycode 00 -> US: the world domain marks every
5 GHz channel no-IR. persist.vendor.audio.device jack -> hdmi0: that single
property is the whole output switch, and editing
audio_policy_configuration.xml / car_audio_configuration.xml instead produces
a SIGABRT boot loop with sys.boot_completed never set.

wifi/wpa_supplicant_overlay.conf — country=US. brcmfmac learns a country no
other way here: the bcmdhd vendor HAL cannot tell it one, and there is no iw
binary on the image. wpa_supplicant issues NL80211_CMD_REQ_SET_REG itself.

audio/usb_audio_policy_configuration.xml — "USB Device Out" and "USB Headset
Out" carried no <profile>, so the format came from the device and the highest
won (S24_3LE on a full-speed headset). Pinned to 16-bit, matching the input
ports which were already declared so.

audio/alsa_utils/alsa_device_profile.c — the USB path took the ALSA *minimum*
period count (2). With the 5 ms period that is a 10 ms ring, and it under-ran
~10x/second in both directions: playback inaudible, capture ~75% fabricated
silence, which a level meter reads as healthy. Now honours
ro.audio.usb.period_count, clamped to the device's own min/max and defaulting
to the previous behaviour when unset. vendor.prop asks for 10 ms x 8. Both
knobs are ro. props read at HAL start, so they retune by editing
/vendor/build.prop with no rebuild.

sepolicy — /dev/media0 fell back to the generic `device` type: core policy
labels /dev/video[0-9]* but nothing labels /dev/media*. rpivid is a stateless
Request-API device and needs the media node for control submission, so under
enforcing this stops hardware HEVC decode outright, presenting as a codec
regression rather than a policy one. Inert while the board is permissive.

device.mk — service.adb.root=1 so adb root survives a reboot.
---
 BoardConfig.mk                                |  4 ++
 audio/alsa_utils/alsa_device_profile.c        | 18 +++++++-
 audio/usb_audio_policy_configuration.xml      | 18 +++++++-
 boot/config.txt                               | 11 +++++
 carlink/carlink_boot.sh                       | 25 +++++++++++
 carlink/carlink_eth0.rc                       | 15 +++++++
 ...app-permissions-com.carlink.projection.xml | 44 +++++++++++++++++++
 device.mk                                     | 23 ++++++++++
 sepolicy/device.te                            |  8 ++++
 sepolicy/file_contexts                        |  1 +
 sepolicy/mediacodec.te                        |  4 ++
 vendor.prop                                   | 13 +++++-
 wifi/wpa_supplicant_overlay.conf              |  7 ++-
 13 files changed, 185 insertions(+), 6 deletions(-)
 create mode 100755 carlink/carlink_boot.sh
 create mode 100644 carlink/carlink_eth0.rc
 create mode 100644 carlink/privapp-permissions-com.carlink.projection.xml

diff --git a/BoardConfig.mk b/BoardConfig.mk
index 26444a0..3699e5c 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -68,3 +68,7 @@ BOARD_HOSTAPD_PRIVATE_LIB := lib_driver_cmd_$(BOARD_WLAN_DEVICE)
 BOARD_WPA_SUPPLICANT_DRIVER := NL80211
 BOARD_WPA_SUPPLICANT_PRIVATE_LIB := lib_driver_cmd_$(BOARD_WLAN_DEVICE)
 WPA_SUPPLICANT_VERSION := VER_0_8_X
+
+# --- AAOS custom ---
+# CPU governor forced to performance at boot — see scripts/vm/apply-customizations.sh
+BOARD_KERNEL_CMDLINE += cpufreq.default_governor=performance
diff --git a/audio/alsa_utils/alsa_device_profile.c b/audio/alsa_utils/alsa_device_profile.c
index a34ae08..57dac24 100644
--- a/audio/alsa_utils/alsa_device_profile.c
+++ b/audio/alsa_utils/alsa_device_profile.c
@@ -420,7 +420,23 @@ static int read_alsa_device_config(alsa_device_profile * profile, struct pcm_con
         config->rate = 44100;
     }
     config->period_size = profile_calc_min_period_size(profile, config->rate);
-    config->period_count = pcm_params_get_min(alsa_hw_params, PCM_PARAM_PERIODS);
+    /* pcm_params_get_min() is the ALSA *minimum* number of periods, which is 2
+     * on a typical USB audio device. Two periods leaves no scheduling slack at
+     * all: with the 5 ms period above that is a 10 ms ring, and on a full-speed
+     * device it under-runs roughly ten times a second in both directions
+     * (measured on a Pi 4, 2026-08-16 — playback inaudible, capture ~75%
+     * fabricated silence). The built-in path already honours
+     * ro.hardware.audio.tinyalsa.period_count; this gives the USB path the same
+     * knob, clamped to what the device actually supports. Absent the property
+     * the behaviour is unchanged. */
+    {
+        unsigned int min_periods = pcm_params_get_min(alsa_hw_params, PCM_PARAM_PERIODS);
+        unsigned int max_periods = pcm_params_get_max(alsa_hw_params, PCM_PARAM_PERIODS);
+        int want = property_get_int32("ro.audio.usb.period_count", (int32_t)min_periods);
+        if (want < (int)min_periods) want = (int)min_periods;
+        if (max_periods != 0 && want > (int)max_periods) want = (int)max_periods;
+        config->period_count = (unsigned int)want;
+    }
     config->format = get_pcm_format_for_mask(pcm_params_get_mask(alsa_hw_params, PCM_PARAM_FORMAT));
 #ifdef LOG_PCM_PARAMS
     log_pcm_config(config, "read_alsa_device_config");
diff --git a/audio/usb_audio_policy_configuration.xml b/audio/usb_audio_policy_configuration.xml
index a450602..9e5a6d2 100644
--- a/audio/usb_audio_policy_configuration.xml
+++ b/audio/usb_audio_policy_configuration.xml
@@ -29,8 +29,22 @@
             <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                      samplingRates="48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
         </devicePort>
-        <devicePort tagName="USB Device Out" type="AUDIO_DEVICE_OUT_USB_DEVICE" role="sink"/>
-        <devicePort tagName="USB Headset Out" type="AUDIO_DEVICE_OUT_USB_HEADSET" role="sink"/>
+        <!-- These two carried no <profile>, so the format was read from the device
+             and the highest advertised one won. A full-speed USB headset that
+             advertises both Altset 1 (S16_LE) and Altset 2 (S24_3LE) got S24_3LE:
+             288 kB/s over a 12 Mbit/s link with a 10 ms ring, which produced
+             ~10 "AHAL_StreamAlsa: incomplete data" drops per second in BOTH
+             directions (measured on Apple EarPods, Pi 4, 2026-08-16). Pinning
+             16-bit is a third less bandwidth on a link that was already failing.
+             The input ports below were already declared 16-bit. -->
+        <devicePort tagName="USB Device Out" type="AUDIO_DEVICE_OUT_USB_DEVICE" role="sink">
+            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
+                     samplingRates="44100,48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+        </devicePort>
+        <devicePort tagName="USB Headset Out" type="AUDIO_DEVICE_OUT_USB_HEADSET" role="sink">
+            <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
+                     samplingRates="44100,48000" channelMasks="AUDIO_CHANNEL_OUT_STEREO"/>
+        </devicePort>
         <devicePort tagName="USB Device In" type="AUDIO_DEVICE_IN_USB_DEVICE" role="source">
             <profile name="" format="AUDIO_FORMAT_PCM_16_BIT"
                 samplingRates="48000" channelMasks="AUDIO_CHANNEL_IN_STEREO"/>
diff --git a/boot/config.txt b/boot/config.txt
index 19b7536..bbf275a 100644
--- a/boot/config.txt
+++ b/boot/config.txt
@@ -45,3 +45,14 @@ dtoverlay=dwc2,dr_mode=peripheral
 [cm4]
 dtoverlay=dwc2,dr_mode=otg
 [all]
+
+# Do NOT enable dtoverlay=miniuart-bt on this board.
+# The overlay leaves a bluetooth node on both UARTs, so hci_uart_bcm (a serdev
+# driver, bound via device tree) attaches to serial0-0 — the PL011 the overlay
+# has just routed to the GPIO header. HCI then goes out the console pins and
+# the console goes to the BT chip: silent UART, plus "Frame reassembly failed
+# (-84)", "command 0xfc18 tx timeout", "hardware error 0x10" and a
+# com.android.bluetooth crash loop. Verified on a Pi 4 Rev 1.5, 2026-08-16.
+# Without it, BT is on PL011 (BCM4345C0.hcd patchram loads clean) and the
+# console is on the mini-UART, matching console=ttyS0,115200 in cmdline.txt.
+#dtoverlay=miniuart-bt
diff --git a/carlink/carlink_boot.sh b/carlink/carlink_boot.sh
new file mode 100755
index 0000000..5b70588
--- /dev/null
+++ b/carlink/carlink_boot.sh
@@ -0,0 +1,25 @@
+#!/vendor/bin/sh
+#
+# Give eth0 an address. Nothing runs DHCP on the direct RJ45 link to the
+# workstation and Android's EthernetManager never claims eth0 on this board, so
+# without this the interface is up with no address and adb-over-TCP on the wire
+# is unreachable. persist.adb.tcp.port=5555 already ships enabled.
+#
+# There is no sshd on the image, so adb-over-TCP is the RJ45 shell.
+#
+# The regulatory domain is NOT set here: wpa_supplicant issues
+# NL80211_CMD_REQ_SET_REG from country=US in wpa_supplicant_overlay.conf, which
+# does not depend on an `iw` binary being present.
+
+ADDR=1.1.1.2/24
+IFACE=eth0
+
+# Don't fight anything that has already configured the link.
+if ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q 'inet '; then
+    log -t carlink_boot "$IFACE already has an address; leaving it alone"
+    exit 0
+fi
+
+ip link set "$IFACE" up 2>/dev/null
+ip addr add "$ADDR" dev "$IFACE" 2>/dev/null
+log -t carlink_boot "$IFACE -> $ADDR"
diff --git a/carlink/carlink_eth0.rc b/carlink/carlink_eth0.rc
new file mode 100644
index 0000000..066805e
--- /dev/null
+++ b/carlink/carlink_eth0.rc
@@ -0,0 +1,15 @@
+# Static address on eth0 once userspace is up.
+#
+# seclabel is REQUIRED and is the whole trick: init refuses to start a
+# /system/bin/sh (or /vendor/bin/sh) service because shell_exec has no domain
+# transition from init, and that check fires even under permissive SELinux. The
+# service simply never runs and init logs nothing obvious.
+service carlink_eth0 /vendor/bin/sh /vendor/bin/carlink_boot.sh
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:su:s0
+
+on property:sys.boot_completed=1
+    start carlink_eth0
diff --git a/carlink/privapp-permissions-com.carlink.projection.xml b/carlink/privapp-permissions-com.carlink.projection.xml
new file mode 100644
index 0000000..d3ed6c6
--- /dev/null
+++ b/carlink/privapp-permissions-com.carlink.projection.xml
@@ -0,0 +1,44 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Privileged-permission allowlist for the CarPlay projection system app.
+
+  Declaring a signature|privileged permission in a manifest does not grant it:
+  since Android 8 the package must also be listed here. On many builds an app in
+  /system/priv-app requesting a privileged permission that is NOT allowlisted is
+  a BOOT-BLOCKING fatal rather than a silent denial, so this file must be present
+  in the image BEFORE the APK is installed to /system/priv-app.
+
+  Shipping it here is harmless when the APK is absent — it is an allowlist entry,
+  not a package reference. It is what lets install_projection_app.sh in system
+  mode be a copy-and-reboot rather than a two-step with a boot-loop window.
+
+  Every entry maps to something the app actually calls.
+-->
+<permissions>
+    <privapp-permissions package="com.carlink.projection">
+
+        <!-- CarProjectionManager.updateProjectionStatus and addKeyEventHandler both
+             check this. Without it the platform never learns a CarPlay session
+             exists: the power policy's PROJECTION component, the HMI and every
+             other app see nothing, and the steering-wheel voice and call keys keep
+             their default handling instead of reaching CarPlay. -->
+        <permission name="android.car.permission.CAR_PROJECTION"/>
+
+        <!-- Read back projection status. -->
+        <permission name="android.car.permission.ACCESS_CAR_PROJECTION_STATUS"/>
+
+        <!-- CarUxRestrictionsManager: the drive-state source that becomes iOS
+             setLimitedUI. -->
+        <permission name="android.car.permission.CAR_UX_RESTRICTIONS_CONFIGURATION"/>
+
+        <!-- "Return to CarPlay" without restarting the session: moveTaskToFront on
+             the existing projection task rather than a relaunch. Quality-of-life
+             rather than load-bearing. -->
+        <permission name="android.permission.REAL_GET_TASKS"/>
+        <permission name="android.permission.MANAGE_ACTIVITY_TASKS"/>
+
+        <!-- Own the audio path and duck for navigation and alerts. -->
+        <permission name="android.permission.MODIFY_AUDIO_ROUTING"/>
+
+    </privapp-permissions>
+</permissions>
diff --git a/device.mk b/device.mk
index 43f618b..9da830c 100644
--- a/device.mk
+++ b/device.mk
@@ -197,3 +197,26 @@ PRODUCT_PACKAGES += \
 
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.wifi.xml:$(TARGET_COPY_OUT_VENDOR)/etc/permissions/android.hardware.wifi.xml
+
+# --- AAOS custom ---
+# Files app — see scripts/vm/apply-customizations.sh
+PRODUCT_PACKAGES += DocumentsUI
+
+# --- AAOS custom props ---
+# adbd-over-TCP on port 5555 (userdebug) + ethernet on by default.
+# These land in system/build.prop; init reads them on boot.
+# See scripts/vm/apply-customizations.sh.
+PRODUCT_SYSTEM_PROPERTIES += \
+    persist.adb.tcp.port=5555 \
+    service.adb.tcp.port=5555 \
+    persist.sys.ethernet.enable=1 \
+    ro.tether.denied=false
+
+# --- Pi 4 platform corrections, 2026-08-22 ---
+# Hardware-verified; see docs/os-corrections-2026-08-16.md.
+
+# adb root across reboots. `adb remount` refuses on this board ("bootloader
+# unlocked"), but `mount -o remount,rw /` works once adbd is root, and boot
+# config under /boot is editable in place from the running system.
+PRODUCT_SYSTEM_PROPERTIES += \
+    service.adb.root=1
diff --git a/sepolicy/device.te b/sepolicy/device.te
index 14cdde4..615b4cd 100644
--- a/sepolicy/device.te
+++ b/sepolicy/device.te
@@ -1 +1,9 @@
 type cec_device, dev_type;
+
+# rpivid (the stateless HEVC block) is a Media Request API device: control
+# submission goes through /dev/media0, not /dev/video19. Core sepolicy labels
+# /dev/video[0-9]* video_device but has no rule for /dev/media*, so it fell back
+# to the generic `device` type. Inert while the board is permissive, but under
+# enforcing it stops hardware HEVC decode outright — and it presents as a codec
+# regression, not a policy one. Verified on a Pi 4, 2026-08-16.
+type media_device, dev_type;
diff --git a/sepolicy/file_contexts b/sepolicy/file_contexts
index e4bdb38..2d06eeb 100644
--- a/sepolicy/file_contexts
+++ b/sepolicy/file_contexts
@@ -24,3 +24,4 @@
 /dev/block/sda5       u:object_r:system_block_device:s0
 /dev/block/sda6       u:object_r:system_block_device:s0
 /dev/block/sda7       u:object_r:metadata_block_device:s0
+/dev/media[0-9]*        u:object_r:media_device:s0
diff --git a/sepolicy/mediacodec.te b/sepolicy/mediacodec.te
index 7a645a2..b60ea01 100644
--- a/sepolicy/mediacodec.te
+++ b/sepolicy/mediacodec.te
@@ -1,3 +1,7 @@
 gpu_access(mediacodec)
 get_prop(mediacodec, vendor_ffmpeg_config_prop)
 get_prop(mediacodec, vendor_v4l2_config_prop)
+
+# c2.ffmpeg.hevc.decoder drives rpivid through ffmpeg's V4L2 stateless hwaccel,
+# which needs the media controller node as well as the video node.
+allow mediacodec media_device:chr_file rw_file_perms;
diff --git a/vendor.prop b/vendor.prop
index ac28c70..fd23c8d 100644
--- a/vendor.prop
+++ b/vendor.prop
@@ -1,9 +1,18 @@
 # Audio
-persist.vendor.audio.device=jack
+persist.vendor.audio.device=hdmi0
 ro.boot.audio.tinyalsa.simulate_input=true
 ro.config.media_vol_default=20
 ro.config.media_vol_steps=25
 
+# Audio (USB) — see docs/os-corrections-2026-08-16.md and
+# pi/docs/04_IMAGE_REBUILD_GUIDE.md 2.2. Defaults (5000 us / ALSA-minimum
+# periods) give a 10 ms two-period ring that a full-speed USB audio device
+# cannot sustain. 10 ms x 8 = an 80 ms ring, eight times the slack for half
+# the wakeups. Both are ro. props read at HAL start, so they can be retuned
+# on the device by editing /vendor/build.prop — no rebuild needed.
+ro.audio.usb.period_us=10000
+ro.audio.usb.period_count=8
+
 # Bluetooth
 bluetooth.device.class_of_device?=90,2,12
 bluetooth.device.default_name=Raspberry Pi 4
@@ -72,5 +81,5 @@ ro.vendor.v4l2_codec2.encode_concurrent_instances=8
 ro.boot.hypervisor.vm.supported=1
 
 # Wifi
-ro.boot.wificountrycode=00
+ro.boot.wificountrycode=US
 wifi.interface=wlan0
diff --git a/wifi/wpa_supplicant_overlay.conf b/wifi/wpa_supplicant_overlay.conf
index 740792b..4700f98 100644
--- a/wifi/wpa_supplicant_overlay.conf
+++ b/wifi/wpa_supplicant_overlay.conf
@@ -2,4 +2,9 @@ disable_scan_offload=1
 wowlan_triggers=any
 p2p_disabled=1
 filter_rssi=-75
-no_ctrl_interface=
\ No newline at end of file
+no_ctrl_interface=
+# brcmfmac has no country code of its own and the vendor HAL cannot give it
+# one, so wpa_supplicant is what issues NL80211_CMD_REQ_SET_REG. Without this
+# the kernel stays in the world domain (00) and every 5 GHz channel is no-IR.
+# Keep in sync with ro.boot.wificountrycode in vendor.prop.
+country=US
-- 

<?xml version="1.0" encoding="utf-8"?>
<!--
    Car Launcher configuration overlay for AAOS Raspberry Pi 5
    This overlay ensures AOSP apps appear in the car launcher app grid.

    Generated by AAOS build system - configure via settings.conf
-->
<resources>
    <!--
        Apps to show in the launcher even if they don't have automotive-specific metadata.
        This allowlist ensures standard AOSP apps are visible in the car launcher.
    -->
    <string-array name="config_appLaunchersToHide" translatable="false">
        <!-- Empty: Don't hide any launchers -->
    </string-array>

    <!--
        Packages that should always appear in the launcher grid.
        These override the default automotive filtering.
    -->
    <string-array name="config_allowedAppPackages" translatable="false">
        <!-- Files/Documents app -->
        <item>com.android.documentsui</item>
        <!-- Gallery -->
        <item>com.android.gallery3d</item>
        <!-- Music -->
        <item>com.android.music</item>
        <!-- Calendar -->
        <item>com.android.calendar</item>
        <!-- Calculator -->
        <item>com.android.calculator2</item>
        <!-- Contacts -->
        <item>com.android.contacts</item>
        <!-- Clock/Alarm -->
        <item>com.android.deskclock</item>
        <!-- Settings -->
        <item>com.android.settings</item>
        <!-- Browser (if included) -->
        <item>org.porgans.browser</item>
        <item>org.porgans.browser2</item>
        <item>com.porgans.browser</item>
        <!-- WebView test browser -->
        <item>com.aspect.browser</item>
    </string-array>

    <!--
        Show all apps in the launcher, not just automotive-certified ones.
        This is useful for development and hobby builds.
    -->
    <bool name="config_showAllApps">true</bool>

    <!--
        Don't filter apps based on automotive metadata requirements.
    -->
    <bool name="config_filterNonAutomotiveApps">false</bool>
</resources>
